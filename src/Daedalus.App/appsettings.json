{
  "Daedalus": {
    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaModel": "qwen2.5-coder:1.5b",
    "StartupTimeoutSeconds": 30,
    "RequestTimeoutSeconds": 600,
    "MaxConcurrentRequests": 1,
