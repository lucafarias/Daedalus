<ui:FluentWindow
    x:Class="Daedalus.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:behaviors="clr-namespace:Daedalus.App.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Daedalus.App.ViewModels"
    Title="Daedalus — C# Solution Inspector"
    Width="1500"
    Height="900"
    MinWidth="1000"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="EditorForegroundBrush" Color="#D4D4D4" />
        <SolidColorBrush x:Key="EditorLineNumbersBrush" Color="#858585" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252526" />
        <FontFamily x:Key="EditorFontFamily">Consolas</FontFamily>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  TitleBar  -->
            <RowDefinition Height="Auto" />
            <!--  Header  -->
            <RowDefinition Height="Auto" />
            <!--  Progress  -->
            <RowDefinition Height="*" />
            <!--  Main Content  -->
            <RowDefinition Height="5" />
            <!--  GridSplitter Orizzontale  -->
            <RowDefinition Height="120" />
            <!--  System Log  -->
            <RowDefinition Height="Auto" />
            <!--  StatusBar  -->
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Daedalus — C# Solution Inspector"
            Grid.Row="0"
            Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="12,4"
                Command="{Binding SelectSolutionFolderCommand}"
                Content="Select Folder…" />
            <TextBox
                Grid.Column="1"
                Padding="6,4"
                VerticalContentAlignment="Center"
                FontSize="13"
                IsReadOnly="True"
                Text="{Binding SolutionRootPath, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                Margin="8,0,8,0"
                Padding="12,4"
                Command="{Binding StartAnalysisCommand}"
                Content="Start Analysis" />
            <Button
                Grid.Column="3"
                Padding="12,4"
                Command="{Binding StartAnalysisCancelCommand}"
                Content="Cancel" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:ProgressRing
                Grid.Column="0"
                Width="24"
                Height="24"
                Margin="0,0,12,0"
                Visibility="Collapsed">
                <ui:ProgressRing.Style>
                    <Style TargetType="ui:ProgressRing">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBusy}" Value="True" />
                                    <Condition Binding="{Binding ProgressMaximum}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:ProgressRing.Style>
            </ui:ProgressRing>

            <ProgressBar
                Grid.Column="1"
                Height="6"
                VerticalAlignment="Center"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                Maximum="{Binding ProgressMaximum}"
                Minimum="0"
                Visibility="Collapsed"
                Value="{Binding ProgressValue}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProgressMaximum}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <TextBlock
                Grid.Column="2"
                MaxWidth="600"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding StatusMessage}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!--  AREA PRINCIPALE CON SPLITTER  -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!--  Review Queue (Solution Explorer Style)  -->
            <Border
                Grid.Column="0"
                Padding="8"
                Background="{StaticResource PanelBackgroundBrush}"
                CornerRadius="6">
                <DockPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        DockPanel.Dock="Top"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Files requiring review" />
                    <ListBox
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding ReviewQueue}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding CurrentItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,2"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding RelativePath}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding FilePath}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                Background="Transparent" />

            <!--  Editor Panels  -->
            <Grid Grid.Column="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentItem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        Padding="10,4"
                        Command="{Binding PreviousResultCommand}"
                        Content="◀ Previous" />
                    <Button
                        Margin="0,0,18,0"
                        Padding="10,4"
                        Command="{Binding NextResultCommand}"
                        Content="Next ▶" />
                    <Button
                        Margin="0,0,6,0"
                        Padding="10,4"
                        Command="{Binding SaveAndNextCommand}"
                        Content="Save &amp; Next" />
                    <Button
                        Padding="10,4"
                        Command="{Binding SkipCurrentCommand}"
                        Content="Skip" />
                </StackPanel>

                <!--  Top: Original | Proposal  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="1"
                        Background="{StaticResource PanelBackgroundBrush}"
                        CornerRadius="6">
                        <DockPanel>
                            <TextBlock
                                Margin="8,4,8,6"
                                DockPanel.Dock="Top"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Original" />
                            <avalonedit:TextEditor
                                behaviors:AvalonEditBehaviors.BoundText="{Binding CurrentItem.OriginalContent, Mode=OneWay}"
                                behaviors:AvalonEditBehaviors.IsReadOnly="True"
                                behaviors:AvalonEditBehaviors.SynchronizedScrollGroup="merge-panels"
                                behaviors:AvalonEditBehaviors.SyntaxHighlighting="{Binding CurrentSyntax}"
                                Background="{StaticResource EditorBackgroundBrush}"
                                FontFamily="{StaticResource EditorFontFamily}"
                                FontSize="13"
                                Foreground="{StaticResource EditorForegroundBrush}"
                                HorizontalScrollBarVisibility="Auto"
                                LineNumbersForeground="{StaticResource EditorLineNumbersBrush}"
                                ShowLineNumbers="True"
                                VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Border>

                    <GridSplitter
                        Grid.Column="1"
                        Width="5"
                        HorizontalAlignment="Stretch"
                        Background="Transparent" />

                    <Border
                        Grid.Column="2"
                        Padding="1"
                        Background="{StaticResource PanelBackgroundBrush}"
                        CornerRadius="6">
                        <DockPanel>
                            <TextBlock
                                Margin="8,4,8,6"
                                DockPanel.Dock="Top"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="AI Proposal" />
                            <avalonedit:TextEditor
                                behaviors:AvalonEditBehaviors.BoundText="{Binding CurrentItem.ProposedContent, Mode=OneWay}"
                                behaviors:AvalonEditBehaviors.IsReadOnly="True"
                                behaviors:AvalonEditBehaviors.SynchronizedScrollGroup="merge-panels"
                                behaviors:AvalonEditBehaviors.SyntaxHighlighting="{Binding CurrentSyntax}"
                                Background="{StaticResource EditorBackgroundBrush}"
                                FontFamily="{StaticResource EditorFontFamily}"
                                FontSize="13"
                                Foreground="{StaticResource EditorForegroundBrush}"
                                HorizontalScrollBarVisibility="Auto"
                                LineNumbersForeground="{StaticResource EditorLineNumbersBrush}"
                                ShowLineNumbers="True"
                                VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter
                    Grid.Row="2"
                    Height="5"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" />

                <!--  Bottom: Final (editable) + Review Notes  -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Sunto degli interventi  -->
                    <Expander
                        Grid.Row="0"
                        Margin="0,4,0,4"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Header="Architectural Review Notes"
                        IsExpanded="True">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentItem.ReviewNotes}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Border
                            Margin="0,4,0,0"
                            Padding="8"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding CurrentItem.ReviewNotes}"
                                TextWrapping="Wrap" />
                        </Border>
                    </Expander>

                    <Border
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        Padding="1"
                        Background="{StaticResource PanelBackgroundBrush}"
                        CornerRadius="6">
                        <DockPanel>
                            <TextBlock
                                Margin="8,4,8,6"
                                DockPanel.Dock="Top"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="Final result (editable)" />
                            <avalonedit:TextEditor
                                behaviors:AvalonEditBehaviors.BoundText="{Binding FinalText, Mode=TwoWay}"
                                behaviors:AvalonEditBehaviors.IsReadOnly="False"
                                behaviors:AvalonEditBehaviors.SyntaxHighlighting="{Binding CurrentSyntax}"
                                Background="{StaticResource EditorBackgroundBrush}"
                                FontFamily="{StaticResource EditorFontFamily}"
                                FontSize="13"
                                Foreground="{StaticResource EditorForegroundBrush}"
                                HorizontalScrollBarVisibility="Auto"
                                LineNumbersForeground="{StaticResource EditorLineNumbersBrush}"
                                ShowLineNumbers="True"
                                VerticalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="No file selected. Select a solution folder and start the analysis.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentItem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <GridSplitter
            Grid.Row="4"
            Height="5"
            HorizontalAlignment="Stretch"
            Background="Transparent" />

        <!--  System Log  -->
        <Border
            Grid.Row="5"
            Margin="0,4,0,0"
            Padding="8"
            Background="{StaticResource PanelBackgroundBrush}"
            CornerRadius="6">
            <DockPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="System Log" />
                <ListBox
                    behaviors:ListBoxBehaviors.AutoScroll="True"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="{StaticResource EditorFontFamily}"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    ItemsSource="{Binding LogMessages}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <StatusBar
            Grid.Row="6"
            Margin="0,8,0,0"
            Background="Transparent">
            <StatusBarItem>
                <TextBlock
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>